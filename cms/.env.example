# Generate once with openssl rand -hex 32; keep unchanged between deployments.
PAYLOAD_SECRET=
CMS_PUBLIC_URL=http://localhost:3000
# Local path, or /data in the NAS Docker container.
CMS_DATA_DIR=./data
DATABASE_URL=file:./data/payload.db
# The first administrator is bootstrapped on server initialization, never public registration.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
# Supplied by the existing Cloudflare Pages project. Keep this URL secret.
CLOUDFLARE_PAGES_DEPLOY_HOOK=
